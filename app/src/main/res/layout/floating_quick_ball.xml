<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_ball_root"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:background="@drawable/floating_window_background"
    android:elevation="8dp">

    <!-- 默认状态：应用图标 -->
    <ImageView
        android:id="@+id/quick_ball_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_auto_fix"
        android:contentDescription="@string/quick_ball"
        android:tint="?attr/colorOnSurface" />

    <!-- 加载状态：转圈 -->
    <ProgressBar
        android:id="@+id/quick_ball_progress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

</FrameLayout>
