<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_ball_root"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="@drawable/floating_window_background"
    android:elevation="8dp">

    <!-- 图标模式 -->
    <ImageView
        android:id="@+id/quick_ball_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_auto_fix"
        android:contentDescription="@string/quick_ball"
        android:tint="?attr/colorOnSurface" />

    <!-- 文字模式（默认隐藏） -->
    <TextView
        android:id="@+id/quick_ball_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="AI"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:textSize="16sp"
        android:visibility="gone"
        android:fontFamily="sans-serif-medium" />

    <!-- 加载状态：MD3 CircularProgressIndicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/quick_ball_progress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateTint="?attr/colorPrimary" />

</FrameLayout>
