<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/accent_swatch"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:contentDescription="@string/about_accent"
        android:padding="20dp"
        android:src="@drawable/ic_auto_fix"
        android:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/welcome_theme_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/welcome_theme_body"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/accent_default_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="?attr/colorPrimary"
            android:contentDescription="@string/about_accent_default"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/about_accent_monet"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/accent_blue_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_blue_primary"
            android:contentDescription="@string/about_accent_blue"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/accent_green_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_green_primary"
            android:contentDescription="@string/about_accent_green"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/accent_purple_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_purple_primary"
            android:contentDescription="@string/about_accent_purple"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/accent_pink_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_pink_primary"
            android:contentDescription="@string/about_accent_pink"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/accent_orange_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_orange_primary"
            android:contentDescription="@string/about_accent_orange"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
