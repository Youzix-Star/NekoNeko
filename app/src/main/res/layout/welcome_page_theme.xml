<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/accent_swatch"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:contentDescription="@string/about_accent"
        android:padding="20dp"
        android:src="@drawable/ic_auto_fix"
        android:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/welcome_theme_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/welcome_theme_body"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/accent_default_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="?attr/colorPrimary"
            android:contentDescription="@string/about_accent_gr"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/about_accent_gr"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/accent_monet_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:contentDescription="@string/about_accent_monet"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/about_accent_monet"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/accent_lemon_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_lemon_primary"
            android:contentDescription="@string/about_accent_lemon"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/accent_wh_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_wh_primary"
            android:contentDescription="@string/about_accent_wh"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/accent_koharu_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_koharu_primary"
            android:contentDescription="@string/about_accent_koharu"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/accent_sora_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_sora_primary"
            android:contentDescription="@string/about_accent_sora"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/accent_elink_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_swatch"
            android:backgroundTint="@color/accent_elink_primary"
            android:contentDescription="@string/about_accent_elink"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
