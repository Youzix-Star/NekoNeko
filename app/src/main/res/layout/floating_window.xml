<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/floating_window_background"
    android:padding="16dp"
    android:elevation="8dp"
    android:minWidth="300dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/floating_window_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/minimize_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/icon_button_background"
            android:contentDescription="@string/minimize_floating_window"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_remove"
            android:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/icon_button_background"
            android:contentDescription="@string/close_floating_window"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- 主体内容（最小化时隐藏） -->
    <LinearLayout
        android:id="@+id/window_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 捕获内容标签 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/capture_label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <!-- 捕获的文本显示区域 -->
        <TextView
            android:id="@+id/captured_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/waiting_for_text"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:background="@drawable/text_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:minHeight="64dp"
            android:gravity="start|top" />

        <!-- 捕获按钮 -->
        <Button
            android:id="@+id/capture_button"
                android:minHeight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_text"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:backgroundTint="?attr/colorPrimary"
            android:drawableStart="@drawable/ic_content_copy"
            android:drawablePadding="8dp"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="8dp" />

        <!-- 替换 / 增加 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/replace_button"
                android:minHeight="40dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/replace_text"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="14sp"
                android:backgroundTint="?attr/colorSecondaryContainer"
                android:drawableStart="@drawable/ic_swap_horiz"
                android:drawablePadding="6dp"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/append_button"
                android:minHeight="40dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/append_text"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="14sp"
                android:backgroundTint="?attr/colorSecondaryContainer"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="6dp"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- AI 修改按钮 -->
        <Button
            android:id="@+id/ai_modify_button"
                android:minHeight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_modify"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:textSize="14sp"
            android:backgroundTint="?attr/colorTertiaryContainer"
            android:drawableStart="@drawable/ic_auto_fix"
            android:drawablePadding="8dp"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="8dp" />

        <!-- 日志区域标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/running_log"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <Button
                android:id="@+id/clear_log_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_log"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:background="?attr/selectableItemBackground"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- 日志显示区域 -->
        <ScrollView
            android:id="@+id/log_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/log_background"
            android:padding="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_waiting"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp" />
        </ScrollView>

        <!-- 状态提示 -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10sp"
            android:alpha="0.7"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
