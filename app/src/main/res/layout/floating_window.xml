<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/floatingWindowBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:minWidth="280dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/floating_window_title"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/close_button_background"
                android:contentDescription="@string/close_floating_window"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                android:tint="@color/colorPrimaryVariant" />
        </LinearLayout>

        <!-- 说明文字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:alpha="0.8"
            android:text="@string/capture_hint"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <!-- 捕获的文本显示区域 -->
        <TextView
            android:id="@+id/captured_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/text_background"
            android:gravity="start|top"
            android:minHeight="60dp"
            android:padding="12dp"
            android:text="@string/waiting_for_text"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <!-- 捕获按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/capture_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/capture_text"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_content_copy"
            app:iconGravity="textStart" />

        <!-- 日志区域标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.8"
                android:text="@string/running_log"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_log_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/clear_log"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                app:backgroundTint="@color/floatingButtonOverlay"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconTint="@android:color/white" />
        </LinearLayout>

        <!-- 日志显示区域 -->
        <ScrollView
            android:id="@+id/log_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/log_background"
            android:padding="8dp">

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="@string/log_waiting"
                android:textColor="@color/logText"
                android:textSize="10sp" />
        </ScrollView>

        <!-- 状态提示 -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:gravity="center"
            android:text="@string/status_hint"
            android:textColor="@android:color/white"
            android:textSize="10sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
